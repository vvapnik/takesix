{
  "name": "takesix-site",
  "private": true,
  "description": "Landing page and live demo of TakeSix, published on GitHub Pages",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "og": "sh scripts/og-image.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@takesix/core": "^0.5.0",
    "@takesix/react": "^0.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
